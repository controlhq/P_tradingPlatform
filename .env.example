# Copy to .env and fill in. Read by docker compose and by the backend (spring.config.import).

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=trading
DB_USERNAME=trading
DB_PASSWORD=change-me

# JWT (HS256 key, min 32 bytes). Generate e.g.: openssl rand -base64 48
JWT_SECRET=

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Market simulator (hours in Europe/Warsaw, Mon-Fri). true = always open, handy for a demo
MARKET_OPEN_TIME=09:00
MARKET_CLOSE_TIME=17:00
MARKET_ALWAYS_OPEN=true
MARKET_TICK_INTERVAL_MS=3000
MARKET_VOLATILITY=0.005
